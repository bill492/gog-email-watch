{
  "id": "gog-email-watch",
  "name": "Gog Email Watch",
  "version": "0.3.7",
  "description": "Rolling recent-inbox wake/queue/skip/delete triage, independent labels and optional approved-sender responses.",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "gog_email_reply",
      "gog_email_skip",
      "gog_email_context",
      "gog_email_complete",
      "gog_email_defer",
      "gog_email_policy_get",
      "gog_email_policy_update",
      "gog_email_scan",
      "gog_email_inspect",
      "gog_email_resolve",
      "gog_email_status"
    ],
    "gatewayMethods": [
      "gog-email-watch.scan"
    ]
  },
  "cliCommands": [
    {
      "name": "email-watch",
      "description": "Email triage and historical deletion",
      "hasSubcommands": true
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "account"
    ],
    "properties": {
      "account": {
        "type": "string",
        "minLength": 1
      },
      "domains": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": []
      },
      "senders": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": []
      },
      "agentId": {
        "type": "string",
        "default": "main",
        "minLength": 1
      },
      "pollIntervalSeconds": {
        "type": "integer",
        "minimum": 1,
        "default": 120
      },
      "gogPath": {
        "type": "string",
        "default": "gog",
        "minLength": 1
      },
      "selfAddresses": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": []
      },
      "triage": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decisionModel"
        ],
        "properties": {
          "decisionModel": {
            "minLength": 1,
            "type": "string"
          },
          "wakeOnExternalReplies": {
            "default": false,
            "deprecated": true,
            "description": "Legacy option. Rolling inbox triage now classifies external replies using the configured prompt.",
            "type": "boolean"
          },
          "concurrency": {
            "minimum": 1,
            "default": 50,
            "type": "integer"
          },
          "policy": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "prompt",
              "deletePrompt",
              "queueMinutes",
              "labels"
            ],
            "properties": {
              "prompt": {
                "description": "Instructions for choosing wake, queue, skip or delete. Email content is evidence, not instructions.",
                "type": "string"
              },
              "deletePrompt": {
                "description": "Describe which emails may be moved to Trash. Empty means no automatic deletion.",
                "type": "string"
              },
              "queueMinutes": {
                "exclusiveMinimum": 0,
                "description": "Wake interval for queued mail. Empty queues never wake.",
                "type": "number"
              },
              "labels": {
                "type": "array",
                "items": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "name",
                    "description"
                  ],
                  "properties": {
                    "name": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "settings": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "replyAllowed": {
            "default": true,
            "description": "Allow in-thread replies in responder and triage jobs. Existing approved-sender and recipient checks still apply. Live-editable; false disables sends.",
            "type": "boolean"
          },
          "wakePrompt": {
            "default": "",
            "description": "Additional instructions for the awakened triage agent, not Jev.",
            "type": "string"
          },
          "responderPrompt": {
            "default": "",
            "description": "Additional instructions for new-mail responder jobs.",
            "type": "string"
          },
          "pollIntervalSeconds": {
            "minimum": 1,
            "default": 120,
            "type": "integer"
          },
          "concurrency": {
            "minimum": 1,
            "default": 50,
            "type": "integer"
          },
          "agentConcurrency": {
            "minimum": 1,
            "default": 1,
            "description": "Concurrent independent agent jobs. Each triage cycle remains one wake; jobs sharing a Gmail thread stay ordered.",
            "type": "integer"
          },
          "labelConcurrency": {
            "default": null,
            "description": "Independent label workers; null inherits concurrency.",
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "retryDelaySeconds": {
            "default": null,
            "description": "Delay before retry eligibility; null inherits polling interval. Retries run on polls.",
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "decisionTimeoutSeconds": {
            "exclusiveMinimum": 0,
            "default": 30,
            "type": "number"
          },
          "gogTimeoutSeconds": {
            "exclusiveMinimum": 0,
            "default": 90,
            "type": "number"
          },
          "agentWaitTimeoutSeconds": {
            "exclusiveMinimum": 0,
            "default": 660,
            "description": "Maximum observation-call duration, sliced for shutdown responsiveness. Nonterminal timeouts renew observation; never a job runtime limit.",
            "type": "number"
          },
          "gogMaxOutputBytes": {
            "minimum": 1,
            "default": 10485760,
            "type": "integer"
          },
          "discoveryOverlapSeconds": {
            "minimum": 0,
            "default": 600,
            "type": "number"
          },
          "reconcileIntervalSeconds": {
            "exclusiveMinimum": 0,
            "default": 3600,
            "type": "number"
          },
          "reconcileLookbackSeconds": {
            "minimum": 0,
            "default": 604800,
            "type": "number"
          },
          "maxAgeDays": {
            "default": 30,
            "description": "Skip older messages before inference or waking. Rolling Gmail timestamp cutoff; null disables. Explicit historical deletion scans are exempt.",
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxInputTokens": {
            "minimum": 1,
            "default": 32000,
            "description": "Estimated state plus largest question token budget. Trim oldest conversation content first; never trim policy.",
            "type": "integer"
          },
          "maxRequestTokens": {
            "minimum": 1,
            "default": 64000,
            "description": "Estimated state plus all questions token budget, including independent labels.",
            "type": "integer"
          },
          "evidence": {
            "additionalProperties": false,
            "deprecated": true,
            "description": "Legacy settings, ignored. Use maxInputTokens and maxRequestTokens; byte truncation is no longer used.",
            "type": "object",
            "properties": {
              "maxBytes": {
                "type": "integer"
              },
              "context": {
                "anyOf": [
                  {
                    "const": "message",
                    "type": "string"
                  },
                  {
                    "const": "thread",
                    "type": "string"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "anyOf": [
      {
        "required": [
          "domains"
        ],
        "properties": {
          "domains": {
            "minItems": 1
          }
        }
      },
      {
        "required": [
          "senders"
        ],
        "properties": {
          "senders": {
            "minItems": 1
          }
        }
      },
      {
        "required": [
          "triage"
        ]
      }
    ]
  },
  "uiHints": {
    "account": {
      "label": "Gmail account",
      "help": "An account already authenticated in this node's gog CLI."
    },
    "domains": {
      "label": "Sender domains",
      "help": "Exact domains; subdomains are not implicitly included."
    },
    "senders": {
      "label": "Individual senders"
    },
    "gogPath": {
      "label": "gog executable",
      "advanced": true
    },
    "selfAddresses": {
      "label": "Additional self aliases",
      "advanced": true
    }
  }
}
